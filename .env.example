# PQ-REACT MCP Server — environment template.
# Copy to .env (gitignored) and fill in. The server stack and the chat
# client read overlapping subsets of these vars.

# ── Server stack (Docker compose) ────────────────────────────────────────
MCP_DB_ROOT_PW=replace-with-strong-random-password
MCP_DB_PW=replace-with-strong-random-password
MCP_DB_NAME=PQREACT
MCP_DB_USER=pqreact
MCP_DB_PORT=3307
MCP_SSE_PORT=5040

# ── Cross-stack reach: QUJATA-TID benchmark (optional) ───────────────────
# Leave blank to disable QUJATA-aware MCP tools (they soft-fail).
QUJATA_DB_HOST=
QUJATA_DB_PORT=3306
QUJATA_DB_NAME=qujata
QUJATA_DB_USER=root
QUJATA_DB_PASSWORD=
QUJATA_API_BASE=

# ── Cross-stack reach: Katana Slice Manager (optional) ───────────────────
# KATANA_NBI_BASE example:  http://<katana-nbi-host>:8000/api
# KATANA_KPI_BASE example:  http://<katana-kpi-host>:8080
KATANA_NBI_BASE=
KATANA_KPI_BASE=
# Mutating slice tools are off by default. Flip with care.
KATANA_ALLOW_CREATE=false
KATANA_ALLOW_DELETE=false

# ── UC3 (Campaign A) reach: Besu IBFT validator + optional Kyber daemon ──
# UC3 = original PQ-REACT use case 3 (5G slicing + DLT + Kyber-768 KEM).
# Used by uc3_blockchain_status / uc3_kpi_summary / uc3_health MCP tools.
# Leave blank to skip the corresponding readiness check (uc3_health
# downgrades to "FAIL: BESU_RPC_BASE not configured" gracefully).
# BESU_RPC_BASE example:        http://<core-vm-host>:8545
# UC3_KYBER_HEALTH_URL example: http://<ran-vm-host>:9799/health
BESU_RPC_BASE=
UC3_KYBER_HEALTH_URL=
UC3_HTTP_TIMEOUT=5

# UC3 Phase 7b — exec runners (uc3_run_bandwidth_validation,
# uc3_run_kpi_experiments). UC3_ALLOW_EXEC must be 'true' for either
# to spawn its subprocess; both write a row to uc3_runs BEFORE spawn.
# UC3_BIN_DIR points at the directory holding platform/bin/run_uc3_*.sh
# on the MCP server's filesystem (typical: a clone or volume mount of
# KatanaSliceManagerv2/platform/bin/). UC3_ARTIFACTS_DIR is read-only —
# safe to set even when UC3_ALLOW_EXEC=false (uc3_list_artifacts uses
# it without spawning anything).
UC3_ALLOW_EXEC=false
UC3_BIN_DIR=
UC3_ARTIFACTS_DIR=
UC3_RUN_TIMEOUT_S=600

# ── Chat client (FastAPI on Ollama VM) ───────────────────────────────────
# Used by mcp-ollama_server/client_mcp/api.py + client.py.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=glm-4.7-flash:q4_K_M
MCP_SERVER_URL=http://localhost:5040/sse
MCP_API_PORT=8081

# ── Multi-agent orchestrator: per-specialist Ollama backends (optional) ──
# When the chat runs in orchestrator mode (MULTI_AGENT_DEFAULT=true, the
# default), each specialist (`performance` / `regulation` / `qujata`) can
# be pinned to a *different* Ollama server, so for example the lightweight
# regulation/qujata specialists can run on a 7B/8B model on a separate box
# (e.g. a Mac mini with M-series + 24 GB unified memory) while the heavy
# performance specialist keeps the GPU. Two complementary channels:
#
#   1. OLLAMA_BACKENDS — single JSON map; easiest when configuring many
#      specialists at once. Empty/unset ⇒ all specialists fall back to
#      the global OLLAMA_HOST (legacy single-server behaviour).
#   2. SPECIALIST_<LABEL>_OLLAMA_HOST — per-specialist override. Wins
#      over OLLAMA_BACKENDS when both are set, so you can override a
#      single specialist without rewriting the JSON.
#
# Examples (commented out — uncomment to enable):
#
# OLLAMA_BACKENDS={"regulation":"http://mac-llm-host:11434","qujata":"http://mac-llm-host:11434"}
# SPECIALIST_PERFORMANCE_OLLAMA_HOST=http://gpu-vm-host:11434
# SPECIALIST_REGULATION_MODEL=llama3.1:8b
# SPECIALIST_QUJATA_MODEL=qwen2.5:7b
