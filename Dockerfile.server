FROM python:3.11-slim

WORKDIR /app

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

COPY requirements-server.txt /app/requirements-server.txt
RUN pip install --no-cache-dir -r requirements-server.txt

COPY mcp-ollama_server /app/mcp-ollama_server
COPY serve_sse.py /app/serve_sse.py

RUN useradd --uid 10001 --create-home --shell /bin/false mcp && \
    chown -R mcp:mcp /app
USER mcp

ENV MCP_BIND_HOST=0.0.0.0 \
    MCP_BIND_PORT=5040

EXPOSE 5040

# /sse is an endless event stream. The previous check
# (`curl /sse | head -c 1`) never let curl finish on its own: it outlived
# the 5 s timeout, docker killed only the shell, and the orphaned
# curl/head processes were re-parented to PID 1 (python, which does not
# reap children). On the testbed that leaked two zombies per check until
# the container's pids.max was exhausted (~9.5k after ~2 days); from then
# on every healthcheck and `docker exec` failed with
# "OCI runtime exec failed ... procReady not received" and the container
# stayed "unhealthy" although SSE was still serving.
# Bound curl with --max-time so it always exits by itself, and look for
# the endpoint event the server sends first. Run under `init: true`
# (see docker-compose.yml) so any stray child is still reaped.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -sS -N --max-time 3 http://127.0.0.1:5040/sse 2>/dev/null | grep -q '^event: endpoint' || exit 1

CMD ["python", "/app/serve_sse.py"]
